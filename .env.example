# Copy to .env and adjust if needed.
HOST_UID=1000
HOST_GID=1000
DIALOUT_GID=20
PLUGDEV_GID=46

# Local Linux X11 desktop. Usually inherited from the host shell.
# DISPLAY=:0

# Only needed for the xilinx-x11-ssh service when using ssh -X/-Y.
# Create this with: xauth nlist "$DISPLAY" | sed -e 's/^..../ffff/' | xauth -f /tmp/.docker.xauth nmerge -
HOST_XAUTHORITY=/tmp/.docker.xauth

# Optional, for licensed device families/IP.
# XILINXD_LICENSE_FILE=2100@license-server.example.com
# LM_LICENSE_FILE=2100@license-server.example.com
